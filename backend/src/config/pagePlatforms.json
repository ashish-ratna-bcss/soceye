{
  "grievances": {
    "page": "grievances",
    "title": "Public Grievances & Redressal",
    "route": "/grievances",
    "description": "Ingestion and tracking of public complaints, grievances, and mentions across official social channels",
    "platforms": [
      "x",
      "facebook",
      "instagram",
      "telegram"
    ],
    "endpoints": [
      {
        "method": "GET",
        "path": "/api/grievances",
        "controller": "modules/grievances/grievance.controller.js",
        "function": "listGrievances",
        "description": "List filtered public grievances across monitored channels",
        "platforms": ["x", "facebook", "instagram", "telegram"]
      },
      {
        "method": "GET",
        "path": "/api/grievances/stats",
        "controller": "modules/grievances/grievance.controller.js",
        "function": "getStats",
        "description": "Retrieve grievance statistics breakdown by platform and status",
        "platforms": ["x", "facebook", "instagram", "telegram"]
      },
      {
        "method": "GET",
        "path": "/api/grievances/report-stats",
        "controller": "modules/grievances/grievance.controller.js",
        "function": "getReportStats",
        "description": "Retrieve dashboard report KPIs for grievances, suggestions, criticisms, and queries",
        "platforms": ["x", "facebook", "instagram", "telegram"]
      },
      {
        "method": "GET",
        "path": "/api/grievances/sources",
        "controller": "modules/grievances/grievance.controller.js",
        "function": "listSources",
        "description": "List monitored official social profiles/channels configured for grievance tracking",
        "platforms": ["x", "facebook", "instagram", "telegram"]
      },
      {
        "method": "POST",
        "path": "/api/grievances/sources/:id/fetch",
        "controller": "modules/grievances/grievance.controller.js",
        "function": "fetchSource",
        "description": "Fetch latest grievances and comments for a specific source account",
        "platforms": ["x", "facebook", "instagram", "telegram"]
      },
      {
        "method": "POST",
        "path": "/api/grievances/fetch-all",
        "controller": "modules/grievances/grievance.controller.js",
        "function": "fetchAll",
        "description": "Fetch latest grievances and mentions across all active source accounts",
        "platforms": ["x", "facebook", "instagram", "telegram"]
      },
      {
        "method": "GET",
        "path": "/api/grievances/:id",
        "controller": "modules/grievances/grievance.controller.js",
        "function": "getGrievance",
        "description": "Get detailed grievance record by ID",
        "platforms": ["x", "facebook", "instagram", "telegram"]
      },
      {
        "method": "GET",
        "path": "/api/grievance-workflow/reports",
        "controller": "modules/grievances/grievance.report.controller.js",
        "function": "listGrievanceReports",
        "description": "List formal grievance reports and action tickets",
        "platforms": ["x", "facebook", "instagram", "telegram"]
      },
      {
        "method": "POST",
        "path": "/api/grievance-workflow/reports",
        "controller": "modules/grievances/grievance.report.controller.js",
        "function": "createGrievanceReport",
        "description": "Create and classify a formal grievance dossier",
        "platforms": ["x", "facebook", "instagram", "telegram"]
      },
      {
        "method": "POST",
        "path": "/api/grievance-workflow/reports/:id/generate-pdf",
        "controller": "modules/grievances/grievance.report.controller.js",
        "function": "generateGrievanceReportPdf",
        "description": "Generate official PDF report for a grievance",
        "platforms": ["x", "facebook", "instagram", "telegram"]
      },
      {
        "method": "GET",
        "path": "/api/social-profiles/platforms?page=grievances",
        "controller": "modules/social-profiles/socialProfile.controller.js",
        "function": "listPlatforms",
        "description": "Retrieve configured platforms available for the grievances page",
        "platforms": ["x", "facebook", "instagram", "telegram"]
      }
    ]
  },
  "events": {
    "page": "events",
    "title": "Events & Occasions Monitoring",
    "route": "/events",
    "description": "Real-time tracking of scheduled events, VIP movements, rallies, and holidays across social channels",
    "platforms": [
      "x",
      "youtube",
      "facebook",
      "telegram",
      "reddit"
    ],
    "endpoints": [
      {
        "method": "GET",
        "path": "/api/events",
        "controller": "modules/events/event.controller.js",
        "function": "listEvents",
        "description": "List tracked events, schedules, and active monitoring states",
        "platforms": ["x", "youtube", "facebook", "telegram", "reddit"]
      },
      {
        "method": "POST",
        "path": "/api/events",
        "controller": "modules/events/event.controller.js",
        "function": "createEvent",
        "description": "Create a new event with target platforms, keywords, hashtags, and dates",
        "platforms": ["x", "youtube", "facebook", "telegram"]
      },
      {
        "method": "GET",
        "path": "/api/events/:id",
        "controller": "modules/events/event.controller.js",
        "function": "getEvent",
        "description": "Get detailed configuration and status for a specific event",
        "platforms": ["x", "youtube", "facebook", "telegram"]
      },
      {
        "method": "PUT",
        "path": "/api/events/:id",
        "controller": "modules/events/event.controller.js",
        "function": "updateEvent",
        "description": "Update event parameters, keywords, locations, and platforms",
        "platforms": ["x", "youtube", "facebook", "telegram"]
      },
      {
        "method": "GET",
        "path": "/api/events/:id/dashboard",
        "controller": "modules/events/event.controller.js",
        "function": "getEventDashboard",
        "description": "Get event metrics, post breakdown by platform, and sentiment stats",
        "platforms": ["x", "youtube", "facebook", "telegram"]
      },
      {
        "method": "GET",
        "path": "/api/events/:id/content",
        "controller": "modules/events/event.controller.js",
        "function": "getEventContent",
        "description": "Get posts and media collected across platforms for this event",
        "platforms": ["x", "youtube", "facebook", "telegram"]
      },
      {
        "method": "POST",
        "path": "/api/events/:id/run",
        "controller": "modules/events/event.controller.js",
        "function": "runEventScan",
        "description": "Trigger on-demand multi-platform scan for event keywords and hashtags",
        "platforms": ["x", "youtube", "facebook", "telegram"]
      },
      {
        "method": "PUT",
        "path": "/api/events/:id/monitoring",
        "controller": "modules/events/event.controller.js",
        "function": "toggleMonitoring",
        "description": "Enable or disable automated recurring scans for an event",
        "platforms": ["x", "youtube", "facebook", "telegram"]
      },
      {
        "method": "GET",
        "path": "/api/events/report",
        "controller": "modules/events/event.controller.js",
        "function": "getEventsReport",
        "description": "Generate summary analytics report across multiple events",
        "platforms": ["x", "youtube", "facebook", "telegram"]
      },
      {
        "method": "GET",
        "path": "/api/occasion-calendar",
        "controller": "modules/events/event.calendar.controller.js",
        "function": "listOccasionCalendar",
        "description": "List calendar occasions, holidays, and VIP schedules",
        "platforms": ["x", "youtube", "facebook", "telegram"]
      },
      {
        "method": "GET",
        "path": "/api/social-profiles/platforms?page=events",
        "controller": "modules/social-profiles/socialProfile.controller.js",
        "function": "listPlatforms",
        "description": "Retrieve platforms enabled for event tracking (excludes Instagram)",
        "platforms": ["x", "youtube", "facebook", "telegram"]
      }
    ]
  },
  "global_search": {
