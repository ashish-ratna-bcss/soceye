{
  "alerts": {
    "page": "alerts",
    "title": "Alerts & Threat Intelligence",
    "route": "/alerts",
    "description": "Monitors threat keywords, public sentiment, and real-time triggers across social media channels",
    "platforms": [
      "x",
      "youtube",
      "facebook",
      "instagram"
    ],
    "endpoints": [
      {
        "method": "GET",
        "path": "/api/alerts",
        "controller": "modules/alerts/alert.controller.js",
        "function": "listAlerts",
        "description": "Fetch paginated alerts filtered by platform, severity, status, search, and date range",
        "platforms": ["x", "youtube", "facebook", "instagram"]
      },
      {
        "method": "GET",
        "path": "/api/alerts/stats",
        "controller": "modules/alerts/alert.controller.js",
        "function": "getStats",
        "description": "Get alert statistics and counts grouped by platform, severity, and category",
        "platforms": ["x", "youtube", "facebook", "instagram"]
      },
      {
        "method": "GET",
        "path": "/api/alerts/unread",
        "controller": "modules/alerts/alert.controller.js",
        "function": "getUnread",
        "description": "Get count and list of unread alerts",
        "platforms": ["x", "youtube", "facebook", "instagram"]
      },
      {
        "method": "GET",
        "path": "/api/alerts/:id",
        "controller": "modules/alerts/alert.controller.js",
        "function": "getAlert",
        "description": "Retrieve full details and post metadata for a single alert",
        "platforms": ["x", "youtube", "facebook", "instagram"]
      },
      {
        "method": "PUT",
        "path": "/api/alerts/:id",
        "controller": "modules/alerts/alert.controller.js",
        "function": "putAlert",
        "description": "Update alert status, assignment, category, or notes",
        "platforms": ["x", "youtube", "facebook", "instagram"]
      },
      {
        "method": "PUT",
        "path": "/api/alerts/read",
        "controller": "modules/alerts/alert.controller.js",
        "function": "putMarkAllRead",
        "description": "Mark all alerts as read",
        "platforms": ["x", "youtube", "facebook", "instagram"]
      },
      {
        "method": "POST",
        "path": "/api/alerts/translate",
        "controller": "modules/alerts/alert.controller.js",
        "function": "translateAlertContent",
        "description": "Translate alert text/posts to target language",
        "platforms": ["x", "youtube", "facebook", "instagram"]
      },
      {
        "method": "GET",
        "path": "/api/keywords",
        "controller": "modules/alerts/keyword.controller.js",
        "function": "getKeywords",
        "description": "List alert monitoring keywords and their active status",
        "platforms": ["x", "youtube", "facebook", "instagram"]
      },
      {
        "method": "POST",
        "path": "/api/keywords/catalog-rescan",
        "controller": "modules/alerts/keyword.controller.js",
        "function": "catalogRescan",
        "description": "Trigger ingestion scan on social platforms for monitored keywords",
        "platforms": ["x", "youtube", "facebook", "instagram"]
      },
      {
        "method": "GET",
        "path": "/api/social-profiles/platforms?page=alerts",
        "controller": "modules/social-profiles/socialProfile.controller.js",
        "function": "listPlatforms",
        "description": "Retrieve active platform filters for the alerts page",
        "platforms": ["x", "youtube", "facebook", "instagram"]
      }
    ]
  },
