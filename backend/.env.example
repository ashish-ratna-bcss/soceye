PORT=
DATABASE_URL=
# Optional absolute base for uploaded file URLs. Leave unset so uploads are stored as
# same-origin paths (/files/...) — required for nginx deploy. Example:
# PUBLIC_BACKEND_URL=https://your.domain
# Optional privileged URL for CREATE DATABASE when provisioning admin tenant DBs.
# If unset, DATABASE_URL's role must have CREATEDB (or superuser).
# TENANT_PROVISION_DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
#
# Prisma: main schema = roles/users (prisma/schema.prisma).
#         tenant schema = ops tables → blurasaga_<username>_<title>_<id>.
# Seed into a tenant: SEED_DB_NAME=blurasaga_odisha_odisha_blura_saga_3 npm run db:seed:ap
# Used to encrypt platform Blugate/API keys at rest (falls back to JWT_SECRET)
# PLATFORM_SECRETS_KEY=
JWT_SECRET=
JWT_EXPIRES_IN=
CORS_ORIGINS=

# Superadmin bootstrap (used by: node scripts/create-superadmin.js)
# Never commit a real password. Generate a unique value per environment.
# SUPERADMIN_USERNAME=superadmin
# SUPERADMIN_EMAIL=superadmin@blurasaga.local
# SUPERADMIN_NAME=Super Administrator
# SUPERADMIN_PASSWORD=

# Blugate gateway (base URL only — access key + client id live on platforms table)
# One address for every platform (Twitter, Facebook, Instagram, YouTube, Telegram and the global account calls):
BLUGATE_BASE_URL=https://blugate.blurasaga.com

FACEBOOK_BASE_URL=
RAPIDAPI_INSTAGRAM_HOST=
X_BASE_URL=
YOUTUBE_BASE_URL=

SENTIMENT_ANALYSIS=
CUSTOM_SENTIMENT_URL=
MEDIA_ANALYZER_URL=
RAG_API_URL=
BLUWEB_API_URL=

# Telegram uses BLUGATE_BASE_URL above. Set TELEGRAM_BASE_URL only to override it.
# TELEGRAM_BASE_URL=

# Social Media Image OCR Extraction Service (acb GPU box)
OCR_SERVICE_URL=
OCR_TIMEOUT_MS=
