# Copy values into .env as needed.

# MongoDB (current app DB)
MONGODB_URI="mongodb://127.0.0.1:27017/soceye_test"
DB_NAME="soceye_test"

# PostgreSQL (Prisma) — apply ../postgres-schema/schema.sql first
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/sockeye?schema=public"

# Auth (required by src/config/env.js — no fallbacks)
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="24h"
# ALLOW_DEFAULT_ADMIN=true

# Cookies (src/config/cookies.js) — maxAge follows JWT_EXPIRES_IN
COOKIE_CROSS_SITE=false

# Server
PORT=5005
CORS_ORIGINS="http://localhost:3000"
