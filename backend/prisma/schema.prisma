generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model alert_status_history {
  id               BigInt             @id @default(autoincrement())
  alert_id         BigInt
  from_status      alert_status_enum?
  to_status        alert_status_enum
  changed_by       Int?
  changed_by_email String?
  notes            String             @default("")
  at               DateTime           @default(now()) @db.Timestamptz(6)
  alerts           alerts             @relation(fields: [alert_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users            users?             @relation(fields: [changed_by], references: [id], onUpdate: NoAction)

  @@index([alert_id, at(sort: Desc)], map: "idx_alert_status_history_alert")
  @@index([at(sort: Desc), to_status], map: "idx_alert_status_history_at_to")
}

model alert_thresholds {
  id                  Int                  @id @default(autoincrement())
  platform            source_platform_enum @unique
  low_threshold       Int                  @default(100)
  medium_threshold    Int                  @default(500)
  high_threshold      Int                  @default(1000)
  time_window_minutes Int                  @default(60)
  is_active           Boolean              @default(true)
  config              Json                 @default("{}")
  created_at          DateTime             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime             @default(now()) @db.Timestamptz(6)
}

model alerts {
  id                          BigInt                 @id @default(autoincrement())
  content_id                  BigInt
  source_id                   Int?
  content_ref_id              String?
  source_category             String?
  matched_keywords_normalized String[]               @default([])
  event_id                    Int?
  analysis_id                 BigInt?
  alert_type                  alert_type_enum        @default(keyword_risk)
  priority                    priority_legacy_enum   @default(MEDIUM)
  virality_level              virality_level_enum?
  virality_detected_at        DateTime?              @db.Timestamptz(6)
  risk_level                  risk_level_alert_enum
  title                       String
  description                 String
  content_url                 String
  platform                    source_platform_enum
  author                      String
  author_handle               String?
  status                      alert_status_enum      @default(active)
  content_published_at        DateTime?              @db.Timestamptz(6)
  created_at                  DateTime               @default(now()) @db.Timestamptz(6)
  acknowledged_by             Int?
  acknowledged_at             DateTime?              @db.Timestamptz(6)
  is_read                     Boolean                @default(false)
  is_priority                 Boolean                @default(false)
  priority_reason             String                 @default("")
  notes                       String?
  is_investigation            Boolean                @default(false)
  complaint_text              String?
  classification_explanation  String?
  velocity_data               Json?
  threat_details              Json?
  violated_policies           Json                   @default("[]")
  legal_sections              Json                   @default("[]")
  ml_analysis                 Json?
  llm_analysis                Json?
  alert_status_history        alert_status_history[]
  users                       users?                 @relation(fields: [acknowledged_by], references: [id], onUpdate: NoAction)
  analyses                    analyses?              @relation(fields: [analysis_id], references: [id], onUpdate: NoAction)
  contents                    contents               @relation(fields: [content_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  events                      events?                @relation(fields: [event_id], references: [id], onUpdate: NoAction)
  sources                     sources?               @relation(fields: [source_id], references: [id], onUpdate: NoAction)
  reports                     reports[]

  @@index([content_id], map: "idx_alerts_content_id")
  @@index([matched_keywords_normalized], map: "idx_alerts_matched_keywords_gin", type: Gin)
  @@index([platform, content_published_at(sort: Desc)], map: "idx_alerts_platform_published")
  @@index([risk_level, content_published_at(sort: Desc)], map: "idx_alerts_risk_published")
  @@index([source_id], map: "idx_alerts_source_id")
  @@index([status, created_at(sort: Desc)], map: "idx_alerts_status_created")
  @@index([status, platform, content_published_at(sort: Desc)], map: "idx_alerts_status_platform_published")
  @@index([status, content_published_at(sort: Desc)], map: "idx_alerts_status_published")
  @@index([status, alert_type, content_published_at(sort: Desc)], map: "idx_alerts_status_type_published")
  @@index([virality_level, content_published_at(sort: Desc)], map: "idx_alerts_virality_published")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model analyses {
  id                 BigInt          @id @default(autoincrement())
  content_id         BigInt          @unique
  risk_score         Int             @default(0)
  violence_score     Int             @default(0)
  threat_score       Int             @default(0)
  hate_score         Int             @default(0)
  sentiment          sentiment_enum
  risk_level         risk_level_enum
  triggered_keywords String[]        @default([])
  topic              String?
  context            String?
  summary            String?
  explanation        String?
  intent             String?
  confidence         Decimal?        @db.Decimal(6, 3)
  language           String?
  reasons            String[]        @default([])
  highlights         String[]        @default([])
  flagged_lines      Json            @default("[]")
  legal_sections     Json            @default("[]")
  violated_policies  Json            @default("[]")
  layers             Json?
  threat_model       Json?
  llm_analysis       Json?
  analyzed_at        DateTime        @default(now()) @db.Timestamptz(6)
  alerts             alerts[]
  contents           contents        @relation(fields: [content_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([analyzed_at(sort: Desc)], map: "idx_analyses_analyzed_at")
}

model audit_logs {
  id            BigInt   @id @default(autoincrement())
  user_id       Int?
  action        String
  resource_type String?
  resource_id   String?
  details       Json     @default("{}")
  ip            String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  users         users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_audit_logs_created")
  @@index([user_id, created_at(sort: Desc)], map: "idx_audit_logs_user")
}

model comments {
  id            BigInt               @id @default(autoincrement())
  content_id    BigInt
  platform      source_platform_enum @default(youtube)
  comment_id    String
  author        String?
  author_handle String?
  text          String?
  published_at  DateTime?            @db.Timestamptz(6)
  risk_score    Int                  @default(0)
  risk_level    risk_level_enum      @default(low)
  threat_score  Int                  @default(0)
  created_at    DateTime             @default(now()) @db.Timestamptz(6)
  raw_data      Json?
  contents      contents             @relation(fields: [content_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([platform, comment_id], map: "comments_platform_comment_id_uq")
  @@index([content_id], map: "idx_comments_content")
}

model comprehensive_reports {
  id         Int       @id @default(autoincrement())
  start_date DateTime? @db.Timestamptz(6)
  end_date   DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  created_by Int?
  payload    Json
  users      users?    @relation(fields: [created_by], references: [id], onUpdate: NoAction)
}

model content_event_links {
  content_id BigInt
  event_id   Int
  linked_at  DateTime @default(now()) @db.Timestamptz(6)
  contents   contents @relation(fields: [content_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  events     events   @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([content_id, event_id])
  @@index([event_id, content_id], map: "idx_content_event_links_event")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an index with non-default null sort order and requires additional setup for migrations. Visit https://pris.ly/d/default-index-null-ordering for more info.
model contents {
  id                      BigInt                   @id @default(autoincrement())
  source_id               Int?
  platform                source_platform_enum
  content_type            content_type_enum        @default(post)
  content_id              String
  content_url             String
  text                    String                   @default("")
  scraped_content         String?
  author                  String
  author_handle           String
  published_at            DateTime                 @db.Timestamptz(6)
  is_media_archived       Boolean                  @default(false)
  is_deleted              Boolean                  @default(false)
  deleted_at              DateTime?                @db.Timestamptz(6)
  is_expired              Boolean                  @default(false)
  expired_at              DateTime?                @db.Timestamptz(6)
  last_availability_check DateTime?                @db.Timestamptz(6)
  availability_status     availability_status_enum @default(available)
  is_repost               Boolean                  @default(false)
  original_author         String?
  original_author_name    String?
  original_author_avatar  String?
  risk_score              Int                      @default(0)
  risk_level              risk_level_enum          @default(low)
  threat_intent           String?
  sentiment               sentiment_enum           @default(neutral)
  relevance_score         Int?
  relevance_priority      relevance_priority_enum?
  is_locality_related     Boolean?
  views                   Int?
  likes                   Int?
  comments_count          Int?
  replies                 Int?
  retweets                Int?
  shares                  Int?
  quotes                  Int?
  saves                   Int?
  duration                String?
  tags                    String[]                 @default([])
  category_id             String?
  created_at              DateTime                 @default(now()) @db.Timestamptz(6)
  media                   Json                     @default("[]")
  quoted_content          Json?
  url_cards               Json                     @default("[]")
  location                Json?
  media_location          Json?
  analysis_job            Json?
  llm_verdict             Json?
  relevance_meta          Json?
  location_classification Json?
  thumbnails              Json?
  threat_reasons          Json                     @default("[]")
  risk_factors            Json                     @default("[]")
  retweet_network         Json?
  engagement_history      Json                     @default("[]")
  raw_data                Json?
  alerts                  alerts[]
  analyses                analyses?
  comments                comments[]
  content_event_links     content_event_links[]
  sources                 sources?                 @relation(fields: [source_id], references: [id], onUpdate: NoAction)
  engager_analyses        engager_analyses[]
  retweet_relationships   retweet_relationships[]

  @@unique([platform, content_id], map: "contents_platform_content_id_uq")
  @@index([content_id], map: "idx_contents_content_id")
  @@index([platform, risk_level], map: "idx_contents_platform_risk")
  @@index([platform, source_id, published_at(sort: Desc)], map: "idx_contents_platform_source_published")
  @@index([published_at(sort: Desc)], map: "idx_contents_published")
  @@index([relevance_priority, relevance_score(sort: Desc)], map: "idx_contents_relevance_priority_score")
  @@index([source_id, published_at(sort: Desc)], map: "idx_contents_source_published")
  @@index([source_id, risk_level], map: "idx_contents_source_risk")
}

model counters {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  seq        BigInt   @default(0)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

model criticism_contacts {
  id         Int      @id @default(autoincrement())
  name       String
  phone      String?
  department String?
  is_active  Boolean  @default(true)
  meta       Json     @default("{}")
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

model criticism_reports {
  id               Int                     @id @default(autoincrement())
  unique_code      String?                 @unique
  grievance_id     BigInt
  platform         grievance_platform_enum @default(x)
  profile_id       String?
  profile_link     String?
  post_link        String?
  post_date        DateTime?               @db.Timestamptz(6)
  post_description String?
  category         String                  @default("Others")
  remarks          String?
  message          String?
  created_by       Int?
  created_at       DateTime                @default(now()) @db.Timestamptz(6)
  posted_by        Json?
  engagement       Json?
  informed_to      Json?
  media_urls       Json                    @default("[]")
  media_s3_urls    Json                    @default("[]")
  meta             Json                    @default("{}")
  users            users?                  @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  grievances       grievances              @relation(fields: [grievance_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([grievance_id], map: "idx_criticism_reports_grievance")
}

model daily_intelligence_reports {
  id          Int      @id @default(autoincrement())
  report_date DateTime @unique @db.Date
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  created_by  Int?
  payload     Json
  users       users?   @relation(fields: [created_by], references: [id], onUpdate: NoAction)
}

model daily_programmes {
  id                Int                             @id @default(autoincrement())
  programme_date    DateTime                        @db.Date
  category          daily_programme_category_enum
  category_label    String                          @default("")
  sl_no             Int                             @default(1)
  zone              String                          @default("")
  program_name      String                          @default("")
  location          String                          @default("")
  organizer         String                          @default("")
  expected_members  Int                             @default(0)
  programme_time    String                          @default("")
  gist              String                          @default("")
  permission        daily_programme_permission_enum @default(By_Information)
  comments          String                          @default("Required L&O and Traffic BB")
  is_high_priority  Boolean                         @default(false)
  created_by        Int?
  created_at        DateTime                        @default(now()) @db.Timestamptz(6)
  updated_at        DateTime                        @default(now()) @db.Timestamptz(6)
  payload           Json                            @default("{}")
  users             users?                          @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  periscope_uploads periscope_uploads[]

  @@unique([programme_date, category, sl_no], map: "daily_programmes_date_category_sl_uq")
  @@index([programme_date, category], map: "idx_daily_programmes_date_category")
}

model dial100_incidents {
