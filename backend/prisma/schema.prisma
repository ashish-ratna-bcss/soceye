generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Auth registry only — lives on the main database.
/// Role = identity only; page/platform access lives on users.
/// Ops tables live in tenant.schema.prisma → blurasaga_<user>_<title>_<id> DBs.
model roles {
  id         Int      @id @default(autoincrement())
  name       String
  slug       String   @unique
  is_system  Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  users      users[]
}

model users {
  id                 Int      @id @default(autoincrement())
  name               String
  username           String   @unique
  email              String   @unique
  password           String
  role_id            Int
  created_by         Int?
  db_name            String?
  allowed_pages      String[] @default([])
  allowed_platforms  String[] @default([])
  can_manage_users   Boolean  @default(false)
  can_manage_roles   Boolean  @default(false)
  /// Per-admin caps (set by superadmin). null = unlimited.
  max_profiles       Int?
  max_users          Int?
  ui_mode            String   @default("light")
  theme_color        Json     @default("{\"type\":\"gradient\",\"value\":\"linear-gradient(135deg, #0f172a 0%, #38bdf8 100%)\",\"primary_hex\":\"#38bdf8\"}")
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  roles              roles    @relation(fields: [role_id], references: [id], onUpdate: NoAction)
  creator            users?   @relation("user_creator", fields: [created_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  created_users      users[]  @relation("user_creator")
}

model default_policies {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Text
  category_id       String   @unique @db.Text
  definition        String   @db.Text
  legal_sections    Json     @default("[]")
  platform_policies Json     @default("{}")
  keywords          String[] @default([]) @db.Text
  severity_level    String   @default("Medium") @db.Text
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([is_active, category_id])
}
