  media_files                                      Json      @default("[]")
  payload                                          Json      @default("{}")
  users                                            users?    @relation(fields: [created_by], references: [id], onUpdate: NoAction)

  @@unique([incident_date, category, sl_no], map: "dial100_date_category_sl_uq")
  @@index([incident_date, category], map: "idx_dial100_date_category")
}

model engager_analyses {
  id          BigInt    @id @default(autoincrement())
  content_id  BigInt?
  status      String    @default("pending")
  error       String?
  analyzed_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  result      Json      @default("{}")
  contents    contents? @relation(fields: [content_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status, analyzed_at], map: "idx_engager_analyses_status")
}

model event_keywords {
  id       Int                   @id @default(autoincrement())
  event_id Int
  keyword  String
  language keyword_language_enum @default(all)
  events   events                @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([event_id, keyword, language], map: "event_keywords_event_keyword_uq")
  @@index([event_id], map: "idx_event_keywords_event")
}

model events {
  id                       Int                     @id @default(autoincrement())
  name                     String
  description              String                  @default("")
  start_date               DateTime?               @db.Timestamptz(6)
  end_date                 DateTime?               @db.Timestamptz(6)
  location                 String                  @default("")
  platforms                source_platform_enum[]  @default([youtube, x])
  high_risk_threshold      Int?
  medium_risk_threshold    Int?
  polling_interval_minutes Int?
  status                   event_status_enum       @default(paused)
  auto_archive             Boolean                 @default(false)
  last_polled_at           DateTime?               @db.Timestamptz(6)
  created_by               Int?
  origin                   event_origin_enum       @default(manual)
  master_calendar_event_id Int?
  created_at               DateTime                @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                @default(now()) @db.Timestamptz(6)
  alerts                   alerts[]
  content_event_links      content_event_links[]
  event_keywords           event_keywords[]
  users                    users?                  @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  master_calendar_events   master_calendar_events? @relation(fields: [master_calendar_event_id], references: [id], onUpdate: NoAction)
  temp_content             temp_content[]

  @@index([status], map: "idx_events_status")
}

model grievance_settings {
  id                     Int           @id @default(autoincrement())
  settings_key           String        @unique @default("grievance_settings")
  max_sources            Int           @default(5)
  fetch_interval_minutes Int           @default(15)
  auto_fetch_enabled     Boolean       @default(true)
  ai_analysis_enabled    Boolean       @default(true)
  default_priority       priority_enum @default(medium)
  official_contacts      Json          @default("[]")
  report_settings        Json          @default("{}")
  config                 Json          @default("{}")
  updated_by             Int?
  updated_at             DateTime      @default(now()) @db.Timestamptz(6)
  users                  users?        @relation(fields: [updated_by], references: [id], onUpdate: NoAction)
}

model grievance_sources {
  id                Int                     @id @default(autoincrement())
  handle            String
  platform          grievance_platform_enum @default(x)
  display_name      String
  profile_image_url String?
  x_user_id         String?
  is_active         Boolean                 @default(true)
  is_verified       Boolean                 @default(false)
  department        String                  @default("General")
  designation       String?
  contact_number    String?
  total_grievances  Int                     @default(0)
  stats             Json                    @default("{}")
  created_by        Int?
  created_at        DateTime                @default(now()) @db.Timestamptz(6)
  last_checked      DateTime?               @db.Timestamptz(6)
  users             users?                  @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  grievances        grievances[]

  @@unique([platform, handle], map: "grievance_sources_platform_handle_uq")
  @@index([platform, is_active], map: "idx_grievance_sources_active")
}

model grievance_workflow_reports {
  id           Int                     @id @default(autoincrement())
  unique_code  String?                 @unique
  grievance_id BigInt
  platform     grievance_platform_enum @default(x)
  status       String?
  category     String?
  created_by   Int?
  created_at   DateTime                @default(now()) @db.Timestamptz(6)
  updated_at   DateTime                @default(now()) @db.Timestamptz(6)
  payload      Json                    @default("{}")
  users        users?                  @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  grievances   grievances              @relation(fields: [grievance_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([grievance_id], map: "idx_grievance_workflow_reports_grievance")
}

model grievances {
  id                         BigInt                         @id @default(autoincrement())
  complaint_code             String?
  tweet_id                   String                         @unique
  tweet_url                  String                         @default("")
  tagged_account             String
  tagged_account_normalized  String                         @default("")
  grievance_source_id        Int?
  platform                   grievance_platform_enum        @default(x)
  complainant_phone          String?
  source_ref                 String?
  whatsapp_message_sid       String?
  author_handle              String
  author_display_name        String?
  author_profile_image_url   String?
  author_is_verified         Boolean                        @default(false)
  author_follower_count      Int                            @default(0)
  content_text               String
  content_full_text          String?
  post_date                  DateTime                       @db.Timestamptz(6)
  detected_date              DateTime                       @default(now()) @db.Timestamptz(6)
  workflow_status            grievance_workflow_status_enum @default(received)
  classification             grievance_classification_enum  @default(unclassified)
  escalation_count           Int                            @default(0)
  fir_number                 String?
  fir_converted_at           DateTime?                      @db.Timestamptz(6)
  fir_converted_by           Int?
  is_active                  Boolean                        @default(true)
  created_at                 DateTime                       @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime                       @default(now()) @db.Timestamptz(6)
  posted_by                  Json?
  content                    Json?
  context                    Json?
  engagement                 Json?
  workflow_history           Json                           @default("[]")
  workflow_timestamps        Json                           @default("{}")
  escalation_history         Json                           @default("[]")
  acknowledgment             Json?
  complaint                  Json?
  criticism                  Json?
  grievance_workflow         Json?
  query_workflow             Json?
  suggestion                 Json?
  analysis                   Json?
  raw_data                   Json?
  criticism_reports          criticism_reports[]
  grievance_workflow_reports grievance_workflow_reports[]
  users                      users?                         @relation(fields: [fir_converted_by], references: [id], onUpdate: NoAction)
  grievance_sources          grievance_sources?             @relation(fields: [grievance_source_id], references: [id], onUpdate: NoAction)
  query_reports              query_reports[]
  suggestion_reports         suggestion_reports[]

  @@index([is_active, workflow_status, post_date(sort: Desc)], map: "idx_grievances_active_workflow")
  @@index([is_active, classification, post_date(sort: Desc)], map: "idx_grievances_classification")
  @@index([platform, workflow_status, post_date(sort: Desc)], map: "idx_grievances_platform_workflow")
  @@index([grievance_source_id, created_at(sort: Desc)], map: "idx_grievances_source")
  @@index([tagged_account_normalized, post_date(sort: Desc)], map: "idx_grievances_tagged")
  @@index([workflow_status, post_date(sort: Desc)], map: "idx_grievances_workflow_post")
}

model instagram_stories {
  id            BigInt                @id @default(autoincrement())
  source_id     Int?
  story_pk      String                @unique(map: "instagram_stories_story_pk_uq")
  author        String
  author_handle String
  author_avatar String?
  media_type    story_media_type_enum @default(image)
  original_url  String
  s3_url        String?
  s3_key        String?
  published_at  DateTime?             @db.Timestamptz(6)
  expires_at    DateTime?             @db.Timestamptz(6)
  is_expired    Boolean               @default(false)
  risk_score    Int                   @default(0)
  risk_level    risk_level_enum       @default(low)
  created_at    DateTime              @default(now()) @db.Timestamptz(6)
  media         Json                  @default("[]")
  raw_data      Json?
  sources       sources?              @relation(fields: [source_id], references: [id], onUpdate: NoAction)

  @@index([source_id, published_at(sort: Desc)], map: "idx_instagram_stories_source")
}

model keywords {
