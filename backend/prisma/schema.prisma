  incident_date                                    DateTime  @db.Date
  category                                         String
  sl_no                                            Int       @default(0)
  incident_details                                 String    @default("")
  incident_category                                String    @default("")
  location                                         String    @default("")
  date_time                                        DateTime? @db.Timestamptz(6)
  ps_jurisdiction                                  String    @default("")
  zone_jurisdiction                                String    @default("")
  caller_name                                      String    @default("")
  caller_number                                    String    @default("")
  ps_type_of_vehicle                               String    @default("")
  pc_bc                                            String    @default("")
  assigned_to                                      String    @default("")
  assigned_time                                    DateTime? @db.Timestamptz(6)
  received_time                                    DateTime? @db.Timestamptz(6)
  accepted_time                                    DateTime? @db.Timestamptz(6)
  reached_time                                     DateTime? @db.Timestamptz(6)
  response_time_for_accepting_call                 Int       @default(0)
  response_time_acceptance_to_vehicle_reached_mins Int       @default(0)
