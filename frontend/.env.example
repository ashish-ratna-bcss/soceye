# ─── API Base URLs ────────────────────────────────────────────────
# All URLs are auto-detected in development (localhost).
# Set these explicitly for production or custom deployments.

# Node.js backend (default: http://localhost:8000 in dev, origin in prod)
REACT_APP_BACKEND_URL=

# RAG pipeline API (default: http://localhost:8100/api/rag in dev, /api/rag in prod)
REACT_APP_RAG_API_URL=

# OSINT portal API (default: http://localhost:8100/osint in dev, /osint in prod)
REACT_APP_OSINT_API_URL=

# Dev-server proxy target for /osint and /api/rag (default: http://localhost:8100)
REACT_APP_RAG_PROXY_TARGET=
